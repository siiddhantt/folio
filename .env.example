# Provider credentials — keep real keys only in .env. Expired keys fail explicitly.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local services — ARM Macs select compose.yaml:compose.arm64.yaml.
COMPOSE_FILE=compose.yaml
FOLIO_PORT=8000
FOLIO_WEB_PORT=3000
FOLIO_DEVELOPMENT_MODE=false

# PDF admission and extraction — saved console controls override environment seeds.
FOLIO_MAX_UPLOAD_BYTES=26214400
FOLIO_MAX_PAGES=100
FOLIO_PARSER_TIMEOUT_SECONDS=240

# Worker execution and recovery — keep job timeout below the lease duration.
FOLIO_JOB_TIMEOUT_SECONDS=300
FOLIO_WORKER_MONITOR_SECONDS=10
FOLIO_LEASE_SECONDS=420
FOLIO_MAX_ATTEMPTS=3
FOLIO_RETRY_DELAYS_SECONDS=[15,60]
FOLIO_RETRY_JITTER_SECONDS=5
FOLIO_RECOVERY_INTERVAL_SECONDS=15
FOLIO_DISPATCH_GRACE_SECONDS=30
FOLIO_BATCH_SIZE=20
FOLIO_BOOTSTRAP_FAILURE_LIMIT=3

# Shared AI spending — all stages share this allowance; changing env does not reset usage.
FOLIO_SUMMARY_BUDGET_USD=1.00
FOLIO_SUMMARY_DOCUMENT_BUDGET_USD=0.40

# Document summaries — gateway/model changes apply to new uploads.
FOLIO_SUMMARY_ENABLED=false
FOLIO_SUMMARY_GATEWAY=openai
FOLIO_SUMMARY_MODEL_ID=openai/gpt-5.2
FOLIO_SUMMARY_PROVIDER=openai
FOLIO_SUMMARY_INPUT_LIMIT_TOKENS=64000
FOLIO_SUMMARY_MAX_OUTPUT_TOKENS=4096
FOLIO_SUMMARY_TOKEN_MARGIN=2048
FOLIO_SUMMARY_REASONING_EFFORT=none
FOLIO_SUMMARY_TIMEOUT_SECONDS=90
FOLIO_SUMMARY_MAX_ATTEMPTS=2

# Document and query embeddings — existing indexes retain their original gateway.
FOLIO_INDEX_ENABLED=false
FOLIO_INDEX_GATEWAY=openai
FOLIO_INDEX_MODEL_ID=openai/text-embedding-3-small
FOLIO_INDEX_CHUNK_TOKENS=512
FOLIO_INDEX_BATCH_SIZE=32
FOLIO_INDEX_MAX_CHUNKS=4096
FOLIO_INDEX_TIMEOUT_SECONDS=60

# Chat answers — generation settings apply to newly submitted turns.
FOLIO_CHAT_MODEL_ID=openai/gpt-5.2
FOLIO_CHAT_GATEWAY=openai
FOLIO_CHAT_PROVIDER=openai
FOLIO_CHAT_INPUT_LIMIT_TOKENS=16384
FOLIO_CHAT_MAX_OUTPUT_TOKENS=4096
FOLIO_CHAT_TOKEN_MARGIN=2048
FOLIO_CHAT_REASONING_EFFORT=none
FOLIO_CHAT_TIMEOUT_SECONDS=90
FOLIO_CHAT_RETRIEVAL_CHUNKS=6
FOLIO_CHAT_HISTORY_LIMIT_TOKENS=8000

# Follow-up question rewriting.
FOLIO_CHAT_REWRITE_MODEL_ID=openai/gpt-5.2
FOLIO_CHAT_REWRITE_GATEWAY=openai
FOLIO_CHAT_REWRITE_PROVIDER=openai
FOLIO_CHAT_REWRITE_INPUT_LIMIT_TOKENS=16384
FOLIO_CHAT_REWRITE_MAX_OUTPUT_TOKENS=1024
FOLIO_CHAT_REWRITE_REASONING_EFFORT=none
FOLIO_CHAT_REWRITE_TIMEOUT_SECONDS=90

# Conversation memory — older context compression and its generation route.
FOLIO_MEMORY_TRIGGER_TOKENS=6000
FOLIO_MEMORY_TARGET_TOKENS=3000
FOLIO_MEMORY_KEEP_TURNS=2
FOLIO_MEMORY_WAIT_SECONDS=600
FOLIO_MEMORY_MODEL_ID=openai/gpt-5.2
FOLIO_MEMORY_GATEWAY=openai
FOLIO_MEMORY_PROVIDER=openai
FOLIO_MEMORY_INPUT_LIMIT_TOKENS=16384
FOLIO_MEMORY_MAX_OUTPUT_TOKENS=2048
FOLIO_MEMORY_REASONING_EFFORT=none
FOLIO_MEMORY_TIMEOUT_SECONDS=90

# Optional retrieval evaluation — TypeSafe / Jev.
TYPESAFE_API_KEY=
